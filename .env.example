# Async Search System — environment template for docker-compose.yml
#
# COPYING THIS FILE IS OPTIONAL. Every variable below is referenced from
# docker-compose.yml with a default, e.g. ${RABBITMQ_DEFAULT_USER:-guest}, so
#
#     docker compose up --build
#
# works on a clean checkout with no .env file at all. Copy it only when you want to
# change something:
#
#     cp .env.example .env        # macOS / Linux
#     copy .env.example .env      # Windows
#
# Docker Compose picks up a .env sitting next to docker-compose.yml automatically.
# .env is git-ignored; this template is the file that is committed, so keep real
# credentials out of it.


# ---------------------------------------------------------------------------------------
# RabbitMQ credentials
# ---------------------------------------------------------------------------------------
# These seed the broker's default user on first boot AND are handed to the Search Service
# and the Notification Service, so both sides always agree. Change them together or not
# at all.
#
# Note that the broker only reads them when it initialises an empty data directory. If you
# change them after the stack has already run once, reset the broker's volume as well:
#
#     docker compose down -v
#
# guest/guest is the RabbitMQ default and is fine for local development. It is refused for
# any connection that is not from localhost, which is exactly why it must never be carried
# over to a deployed environment.
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest


# ---------------------------------------------------------------------------------------
# Published host ports
# ---------------------------------------------------------------------------------------
# Only the left-hand side of each port mapping. The in-container ports are fixed and are
# not configurable from here — services address each other by container port over the
# compose network (the API Gateway reaches the Search Service at
# http://searchservice:8080 regardless of what is published below).
#
# Change any of these if something else on your machine already owns the port.

# API Gateway — the HTTP/JSON entry point, and the only port you actually need.
#   POST http://localhost:8080/searches            {"destination":"Paris"}
#   GET  http://localhost:8080/searches/{searchId}
APIGATEWAY_HTTP_PORT=8080

# Search Service gRPC endpoint. Published purely for convenience: the workflow never needs
# it from the host, but it is useful for poking the service directly with grpcurl.
SEARCHSERVICE_HTTP_PORT=5001

# RabbitMQ AMQP port, for connecting to the broker from the host.
RABBITMQ_AMQP_PORT=5672

# RabbitMQ management UI — http://localhost:15672, sign in with the credentials above.
# Useful for watching the search.completed exchange and the notification.search.completed
# queue while the workflow runs.
RABBITMQ_MANAGEMENT_PORT=15672
