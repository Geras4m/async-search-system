# Normalize everything to LF in the repository.
* text=auto eol=lf

# Windows-only tooling files keep CRLF in the working tree.
*.sln       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Files consumed inside Linux containers must never gain CRLF.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.proto     text eol=lf

# Generated protobuf output should not clutter diffs or language stats.
**/Protos/*.proto linguist-language=Protocol%20Buffer
