{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672
  },
  "Search": {
    "BatchCount": 6,
    "HotelsPerBatch": 5,
    "BatchInterval": "00:00:05"
  },
  "AllowedHosts": "*"
}
